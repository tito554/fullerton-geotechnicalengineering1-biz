main, .main-content, .content-area, .layout > *:not(aside):not(.sidebar) {
padding-top: 0 !important;
}
body { padding-top: 0 !important; }
/* Cards en grid: layout flex/grid sin colapsar */
.cards-grid, [style*="display:grid"][style*="auto-fill"] {
margin-top: 1rem !important;
}
/* Sidebar sticky pero NO encima del header */
.sb-home, aside.sidebar, .sidebar, aside {
position: sticky !important;
top: 1rem !important;
z-index: 2 !important;
width: 260px !important;
}
/* MATAR position:fixed legacy de fase-i-fixes */
nav.navbar, .header-top, .main-header, header.header, .header {
position: static !important;
top: auto !important;
left: auto !important;
width: auto !important;
}</style><style>/*afx*//* cat-item: BLOCK (no flex) — children flow normal y cat-sub-wrap toma full width */
.cat-item, details {
display: block !important;
position: relative !important;
}
.cat-name {
flex: 1 1 auto !important;
min-width: 0 !important;
word-break: normal !important;
overflow-wrap: break-word !important;
white-space: normal !important;
order: 1 !important;
}
/* Sub-item links */
.cat-sub-wrap a, .cat-sub a, .nav-cat-sub a {
display: block !important;
width: 100% !important;
font-size: .82rem !important;
line-height: 1.25 !important;
padding: .35rem 1rem .35rem 1.8rem !important;
white-space: normal !important;
word-break: normal !important;
overflow-wrap: break-word !important;
box-sizing: border-box !important;
}
/* cat-row interno: SI flex para alinear name + toggle */
.cat-row {
display: flex !important;
flex-wrap: nowrap !important;
align-items: center !important;
justify-content: space-between !important;
width: 100% !important;
}
/* cat-sub-wrap: full width abajo */
.cat-sub-wrap, .cat-sub, .nav-cat-sub {
flex-basis: 100% !important;
width: 100% !important;
max-width: 100% !important;
order: 3 !important;
position: static !important;
background: rgba(0,0,0,.15) !important;
padding: .4rem 0 .8rem !important;
}
.cat-toggle, .cat-arrow {
flex-shrink: 0 !important;
order: 2 !important;
}</style>
